# ProofGate environment configuration.
#
# Nothing in this file is required to run ProofGate in deterministic
# fallback mode -- pytest, the MCP gateway, and the demo/verification
# scripts all work with no .env file present at all. These variables
# only enable optional LIVE integrations (Nebius semantic extraction,
# CRAFT evidence retrieval). Copy this file to .env and fill in real
# values only if you want to exercise those live paths.
#
# Never commit a real .env file. It is already gitignored.

# --- Runtime mode -----------------------------------------------------
# One of: live, fallback, reliable_demo. Defaults to attempting live
# extraction with automatic deterministic fallback on any failure.
PROOFGATE_RUNTIME_MODE=fallback

# --- Nebius Token Factory (optional; live semantic extraction) --------
# Advisory only -- Nebius never issues an ALLOW/BLOCK verdict. Leave
# NEBIUS_API_KEY unset to use the deterministic regex fallback.
NEBIUS_LIVE_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Emergence CRAFT (optional; read-only enterprise evidence) --------
# Never authoritative for mutation impact, never called from the MCP
# gateway or from pytest. Explicitly user-triggered in Streamlit only.
CRAFT_LIVE_ENABLED=false
CRAFT_PROJECT_ID=
CRAFT_MCP_URL=
CRAFT_OAUTH_CLIENT_ID=
CRAFT_DATABASE=
CRAFT_OAUTH_TIMEOUT_SECONDS=30

# --- Demonstration-only flags (off by default) -------------------------
# Deterministic, local-sandbox-only mismatch injection used solely to
# demonstrate genuine postcondition-mismatch detection and automatic
# rollback (see scripts/rollback_demo.py and THREAT_MODEL.md). Never set
# this outside a local demonstration.
DEMO_SIMULATE_POSTCONDITION_MISMATCH=false
